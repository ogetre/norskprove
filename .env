# Non-secret Clerk routing. Keys come from `vercel env pull` into .env.local.
# ANTHROPIC_API_KEY (AI feedback on writing) is a secret too: set it in Vercel, never here.
# Optional site-wide daily caps on AI feedback, set in Vercel: AI_DAILY_REQUESTS (default 300)
# and AI_DAILY_BUDGET_USD (default 1). Each user also has 30 checks a day.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/logg-inn
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registrer
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/trening
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/trening
